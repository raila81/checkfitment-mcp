  "tools": [
    {
      "name": "bolt_pattern_lookup",
      "title": "Vehicle bolt pattern and wheel specs",
      "description": "Use for \"what is the bolt pattern on a 2019 Ford F-150\", lug torque, center bore, thread size, OEM wheel size, offset or tire size of a vehicle, or \"will these wheels fit my car\" when the vehicle is named. Looks the vehicle up in the CheckFitment dataset (a fixed set of vehicles, each spec cited to manufacturer documents and marked verified or unverified). If the vehicle or year is not in the dataset the tool says so (not_in_database / year_covered false) and gives no figures; never fill them in from memory. Optional wheel_center_bore_mm runs the hub-centric check.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string",
            "description": "e.g. Ford, Toyota, Jeep"
          },
          "model": {
            "type": "string",
            "description": "e.g. F-150, Tacoma, Wrangler"
          },
          "year": {
            "type": "integer",
            "minimum": 1950,
            "maximum": 2030
          },
          "wheel_center_bore_mm": {
            "type": "number",
            "description": "Optional: center bore of a wheel you want to check against the hub."
          }
        },
        "required": [
          "make",
          "model"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
