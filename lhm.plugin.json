{
  "cloudEndpoint": "https://checkfitment.com/mcp?src=mcp",
  "description": "Bolt pattern, lug torque and wheel specs by vehicle, plus wheel and tire fitment, tire size change, wheel spacer and gear ratio calculations from a sourced dataset.",
