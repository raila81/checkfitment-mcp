    {
      "name": "wheel_spacer_calculator",
      "title": "Wheel spacer size and stud engagement",
      "description": "Use for \"do I need spacers\", \"what spacer gets +35 wheels to +20\", \"is a 10 mm slip-on spacer safe\". A spacer lowers the effective offset by its thickness. Returns the spacer needed for a target offset (and the nearest common size), the effective offset, track change, whether it is slip-on or bolt-on territory, and, with stud, stud_protrusion_mm and wheel_pad_thickness_mm, the slip-on thread-engagement check (≥ 1 × stud diameter and ≥ 6.5 turns).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offset_mm": {
            "type": "number",
            "minimum": -100,
            "maximum": 100,
            "description": "Offset (ET) of the wheel."
          },
          "target_offset_mm": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "spacer_mm": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "stud": {
            "type": "string",
            "enum": [
              "M12x1.5",
              "M12x1.25",
              "M14x1.5",
              "M14x2.0",
              "1/2-20",
              "9/16-18",
              "7/16-20"
            ]
          },
          "stud_protrusion_mm": {
            "type": "number",
            "minimum": 0,
            "description": "Stud length past the hub face."
          },
          "wheel_pad_thickness_mm": {
            "type": "number",
            "minimum": 0,
            "description": "Thickness of the wheel mounting pad."
          }
        },
        "required": [
          "offset_mm"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "offset_mm": {
            "type": "number"
          },
          "target_offset_mm": {
            "type": [
              "number",
              "null"
            ]
          },
          "spacer_needed": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "exact_mm": {
                "type": "number"
              },
              "possible": {
                "type": "boolean"
              },
              "nearest_common_mm": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "spacer_mm": {
            "type": [
              "number",
              "null"
            ]
          },
          "effective_offset_mm": {
            "type": [
              "number",
              "null"
            ]
          },
          "moves_out_mm": {
            "type": [
              "number",
              "null"
            ]
          },
          "track_change_mm": {
            "type": [
              "number",
              "null"
            ]
          },
          "spacer_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "engagement": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "stud": {
                "type": "string"
              },
              "engaged_before_mm": {
                "type": "number"
              },
              "engaged_after_mm": {
                "type": "number"
              },
              "turns_after": {
                "type": "number"
              },
              "min_mm": {
                "type": "number"
              },
              "min_turns": {
                "type": "number"
              },
              "safe": {
                "type": "boolean"
              },
              "extra_stud_length_needed_mm": {
                "type": "number"
              }
            }
          },
          "link": {
            "type": "string"
          },
          "disclaimer": {
            "type": "string"
          }
