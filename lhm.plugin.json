          },
          "backspacing_new_in": {
            "type": "number"
          },
          "outer_verdict": {
            "type": [
              "string",
              "null"
            ]
          },
          "outer_clearance_left_mm": {
            "type": [
              "number",
              "null"
            ]
          },
          "inner_verdict": {
            "type": [
              "string",
              "null"
            ]
          },
