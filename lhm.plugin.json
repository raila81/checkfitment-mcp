    {
      "name": "wheel_fitment_check",
      "title": "Will these wheels (and tires) fit",
      "description": "Use to compare a current wheel (and tire) with a new one: how far the outer edge pokes toward the fender and the inner edge toward the suspension, the diameter and ride-height change, speedometer effect, backspacing, and whether the new tire width suits the new rim width. With measured clearances (outer: tire edge to fender lip; inner: to the nearest suspension part, both on the current setup) it returns fits / tight / rub. Leave the tire fields out for a wheel-only offset comparison.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "current_wheel_width_in": {
            "type": "number",
            "minimum": 4,
            "maximum": 16
          },
          "current_offset_mm": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "current_tire": {
            "type": "string",
            "description": "Current tire size. Metric like 265/70R17 (P or LT prefix allowed) or flotation like 33x12.50R17; no load index or speed rating."
          },
          "new_wheel_width_in": {
            "type": "number",
            "minimum": 4,
            "maximum": 16
          },
          "new_offset_mm": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "new_tire": {
            "type": "string",
            "description": "New tire size. Metric like 265/70R17 (P or LT prefix allowed) or flotation like 33x12.50R17; no load index or speed rating."
          },
          "outer_clearance_mm": {
            "type": "number",
            "minimum": 0,
            "description": "Measured on the current setup: tire sidewall to fender lip."
          },
          "inner_clearance_mm": {
            "type": "number",
            "minimum": 0,
            "description": "Measured on the current setup: inner sidewall to the nearest suspension or body part."
          }
        },
        "required": [
          "current_wheel_width_in",
          "current_offset_mm",
          "new_wheel_width_in",
          "new_offset_mm"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "wheel_only",
              "wheel_and_tire"
            ]
          },
          "current": {
            "type": "object"
          },
          "new": {
            "type": "object"
          },
          "poke_out_mm": {
            "type": "number"
          },
          "inner_in_mm": {
            "type": "number"
          },
          "center_shift_mm": {
            "type": "number"
          },
          "outer_edge_set_by": {
            "type": "string"
          },
          "inner_edge_set_by": {
            "type": "string"
          },
          "diameter_change_mm": {
            "type": "number"
          },
          "diameter_change_in": {
            "type": "number"
          },
          "ride_height_change_mm": {
            "type": "number"
          },
          "speedometer_reads_low_pct": {
            "type": "number"
          },
          "shown_at_true_60": {
            "type": "number"
          },
          "backspacing_old_in": {
