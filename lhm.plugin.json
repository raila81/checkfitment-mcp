    {
      "name": "bolt_pattern_facts",
      "title": "Bolt pattern in mm and inches, look-alikes",
      "description": "Use for \"what is 5x114.3 in inches\", \"is 5x114.3 the same as 5x115\", \"will 6x135 wheels fit 6x139.7\", or which vehicles use a pattern. Converts mm and inch notation, lists look-alike patterns that do not interchange, the vehicles in the dataset with that pattern, the lug tightening order and typical torque ranges by stud size (guidance only).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "description": "5x114.3, 5x4.5, 6x139.7, 8x6.5 …"
          }
        },
        "required": [
